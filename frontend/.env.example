# Base URL of the local FastAPI backend.
# Not a secret (there is no auth) — copy this file to `.env` only if you need to
# point at a different host/port; the same value is the built-in default in
# src/api/client.ts, so `npm run dev` works with no .env at all.
VITE_API_BASE_URL=http://127.0.0.1:8000
