{
  "components": {
    "schemas": {
      "Bank": {
        "enum": [
          "bradesco",
          "inter"
        ],
        "title": "Bank",
        "type": "string"
      },
      "Body_upload_statements_months__month_ref__uploads_post": {
        "properties": {
          "files": {
            "items": {
              "contentMediaType": "application/octet-stream",
              "type": "string"
            },
            "title": "Files",
            "type": "array"
          }
        },
        "required": [
          "files"
        ],
        "title": "Body_upload_statements_months__month_ref__uploads_post",
        "type": "object"
      },
      "BudgetGoalsRequest": {
        "description": "Full replace of one budget scope (the global default, or one month's\noverrides) \u2014 a settings page naturally edits the whole set and saves once.",
        "properties": {
          "goals": {
            "additionalProperties": {
              "type": "number"
            },
            "title": "Goals",
            "type": "object"
          }
        },
        "title": "BudgetGoalsRequest",
        "type": "object"
      },
      "CreateTransactionRequest": {
        "description": "A transaction the bank statement never had \u2014 e.g. cash spending. Always\nlands at confidence='high': a human is directly asserting date/amount/\ncategory, there's nothing left to review (nodes/transactions.py:create).",
        "properties": {
          "account": {
            "$ref": "#/components/schemas/Bank"
          },
          "amount": {
            "exclusiveMinimum": 0.0,
            "title": "Amount",
            "type": "number"
          },
          "category": {
            "minLength": 1,
            "title": "Category",
            "type": "string"
          },
          "date": {
            "format": "date",
            "title": "Date",
            "type": "string"
          },
          "description_raw": {
            "minLength": 1,
            "title": "Description Raw",
            "type": "string"
          },
          "instrument": {
            "$ref": "#/components/schemas/Instrument",
            "default": "debit"
          },
          "subcategory": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Subcategory"
          },
          "type": {
            "$ref": "#/components/schemas/TransactionType"
          }
        },
        "required": [
          "date",
          "description_raw",
          "account",
          "type",
          "amount",
          "category"
        ],
        "title": "CreateTransactionRequest",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "Instrument": {
        "description": "Payment stream a transaction belongs to.\n\n`debit` covers the debit/PIX current-account extracts (features 001+). `credit`\ncovers itemized credit-card purchases parsed from a fatura PDF (feature 013):\na separate stream, dated by purchase date, that does NOT feed the month's\nheadline expense total \u2014 see docs/decisions/credit-card-stream.md.",
        "enum": [
          "debit",
          "credit"
        ],
        "title": "Instrument",
        "type": "string"
      },
      "ReviewRequest": {
        "properties": {
          "action": {
            "enum": [
              "accept",
              "confirm_transfer",
              "correct"
            ],
            "title": "Action",
            "type": "string"
          },
          "category": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Category"
          },
          "subcategory": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Subcategory"
          }
        },
        "required": [
          "action"
        ],
        "title": "ReviewRequest",
        "type": "object"
      },
      "RunRequest": {
        "properties": {
          "files": {
            "items": {
              "type": "string"
            },
            "title": "Files",
            "type": "array"
          }
        },
        "title": "RunRequest",
        "type": "object"
      },
      "TransactionPatch": {
        "properties": {
          "category": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Category"
          },
          "deleted": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Deleted"
          },
          "subcategory": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Subcategory"
          }
        },
        "title": "TransactionPatch",
        "type": "object"
      },
      "TransactionType": {
        "enum": [
          "income",
          "expense"
        ],
        "title": "TransactionType",
        "type": "string"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
